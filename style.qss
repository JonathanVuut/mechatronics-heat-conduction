QWidget {
    background-color: #121116;
    color: #ece6d8;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

QLabel,
QSlider {
    background-color: transparent;
}

QLabel#main_title,
QLabel#about_title {
    color: #ece6d8;
    font-family: Georgia, "Palatino Linotype", serif;
    font-size: 28px;
    font-weight: 600;
}

QLabel#about_title {
    font-size: 25px;
}

QLabel#eyebrow,
QLabel#section_title {
    color: #b8864b;
    font-size: 10px;
    font-weight: 700;
}

QLabel#section_title {
    font-size: 11px;
}

QLabel#field_label {
    color: #a39c8e;
    min-width: 62px;
}

QLabel#about_value {
    color: #ece6d8;
    font-size: 15px;
}

QLabel#emblem {
    color: #b8864b;
    font-family: Georgia, "Palatino Linotype", serif;
    font-size: 18px;
}

QLabel#github_link {
    color: #b8864b;
    padding-top: 6px;
}

QLabel#github_link a {
    color: #b8864b;
    text-decoration: none;
}

QFrame#body_card,
QFrame#emblem_banner {
    background-color: #1a1821;
    border: 1px solid #2e293a;
    border-radius: 8px;
}

QFrame#left_body_box {
    background-color: #c0392b;
    border: 1px solid #b8864b;
    border-radius: 4px;
}

QFrame#right_body_box {
    background-color: #1c2833;
    border: 1px solid #5b6872;
    border-radius: 4px;
}

QFrame#connector_bar {
    background-color: #68616a;
    border: 1px solid #8b765d;
    border-radius: 4px;
}

QFrame#emblem_banner {
    min-height: 78px;
}

QDoubleSpinBox#left_mass_spinbox,
QDoubleSpinBox#left_heat_capacity_spinbox,
QDoubleSpinBox#right_mass_spinbox,
QDoubleSpinBox#right_heat_capacity_spinbox,
QDoubleSpinBox#numeric_input,
QComboBox {
    background-color: #121116;
    border: 1px solid #3b3546;
    border-radius: 4px;
    color: #ece6d8;
    min-height: 26px;
    padding: 2px 6px;
    selection-background-color: #9e3b33;
}

QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #b8864b;
}

QDoubleSpinBox#left_temperature_spinbox,
QDoubleSpinBox#right_temperature_spinbox {
    background-color: #121116;
    color: #ece6d8;
    min-height: 34px;
    min-width: 130px;
}

QDoubleSpinBox:read-only {
    padding: 6px 12px;
}

QDoubleSpinBox#left_temperature_spinbox QLineEdit,
QDoubleSpinBox#right_temperature_spinbox QLineEdit {
    background-color: transparent;
    color: #ece6d8;
    padding: 0 4px;
}

QComboBox QAbstractItemView {
    background-color: #1a1821;
    border: 1px solid #3b3546;
    color: #ece6d8;
    selection-background-color: #392e31;
}

QPushButton {
    background-color: #24212b;
    border: 1px solid #494252;
    border-radius: 5px;
    color: #ece6d8;
    min-height: 30px;
    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #302a34;
    border-color: #9e3b33;
}

QPushButton:pressed {
    background-color: #1a1821;
}

QPushButton#start_button {
    background-color: #6f302d;
    border-color: #9e3b33;
    font-weight: 600;
    min-height: 36px;
}

QPushButton#start_button:checked {
    background-color: #3a282a;
    border-color: #b8864b;
}

QSlider::groove:vertical {
    background-color: #2e293a;
    border: 1px solid #3b3546;
    border-radius: 3px;
    width: 6px;
}

QSlider::handle:vertical {
    background-color: #b8864b;
    border: 1px solid #d0a56a;
    border-radius: 6px;
    height: 14px;
    margin: 0 -5px;
}

QSlider::handle:vertical:hover {
    background-color: #d0a56a;
}

QSlider::add-page:vertical,
QSlider::sub-page:vertical {
    background-color: #4a3336;
    border-radius: 3px;
}

QSlider::tick-mark:vertical {
    background-color: #68616a;
    width: 4px;
}
